{
  "name": "vilano-runtime",
  "private": true,
  "packageManager": "bun@1.3.8",
  "workspaces": [
    "sdk/typescript",
    "worker/bun",
    "cli"
  ],
  "scripts": {
    "build": "bun run typecheck",
