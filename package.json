{
  "name": "vilano-runtime",
  "private": true,
  "packageManager": "bun@1.3.10",
  "workspaces": [
    "sdk/typescript",
    "worker/bun",
    "cli"
  ],
  "scripts": {
    "check": "bun run typecheck && bun run test",
    "build": "bun run typecheck",
    "typecheck": "tsc -p cli/tsconfig.json && tsc -p sdk/typescript/tsconfig.json && tsc -p worker/bun/tsconfig.json && tsc -p tests/tsconfig.json",
    "test": "bun test tests/integration.test.ts --timeout 30000 --max-concurrency 1",
    "test:integration": "bun run test",
    "test:soak": "bun test tests/soak.test.ts --timeout 360000 --max-concurrency 1",
    "prepare:cli-package": "bun scripts/prepare-cli-runtime-dist.ts",
    "smoke:install": "bun scripts/smoke-install.ts",
    "pack:sdk": "cd sdk/typescript && bun pm pack --dry-run",
    "pack:cli": "bun run prepare:cli-package && cd cli && bun pm pack --dry-run",
    "pack": "bun run pack:sdk && bun run pack:cli"
  },
  "dependencies": {
    "@vilano/runtime": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "^1.3.1",
    "@types/node": "^22.13.10",
    "typescript": "^5.8.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/vilano-ai/runtime.git"
  },
  "license": "UNLICENSED"
}
