{
  "name": "@vilano/runtime",
  "version": "0.1.3",
  "type": "module",
  "description": "TypeScript SDK for Vilano Runtime durable workflows and services.",
  "files": [
    "src",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "node": "./dist/index.js",
      "default": "./src/index.ts"
    }
  },
  "engines": {
    "bun": ">=1.3.10"
  },
  "scripts": {
    "build": "rm -rf dist && bun build ./src/index.ts --format esm --outfile ./dist/index.js && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vilano-ai/runtime.git",
    "directory": "sdk/typescript"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "homepage": "https://github.com/vilano-ai/runtime",
  "keywords": [
    "typescript",
    "sdk",
    "durable-execution",
    "workflow",
    "service",
    "beam",
    "bun"
  ],
  "license": "Apache-2.0"
}
