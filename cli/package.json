{
  "name": "vilano",
  "version": "0.1.2",
  "type": "module",
  "description": "Vilano Runtime CLI for local durable workflow and service orchestration.",
  "bin": {
    "vilano": "bin/vilano.ts"
  },
  "files": [
    "bin",
    "src",
    "runtime-dist",
    "README.md",
    "LICENSE"
  ],
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "engines": {
    "bun": ">=1.3.10"
  },
  "scripts": {
    "build": "bun run typecheck",
    "typecheck": "tsc -p tsconfig.json",
    "prepack": "bun ../scripts/prepare-cli-runtime-dist.ts"
  },
  "dependencies": {
    "ajv": "^8.18.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/vilano-ai/runtime.git",
    "directory": "cli"
  },
  "homepage": "https://github.com/vilano-ai/runtime",
  "keywords": [
    "cli",
    "durable-execution",
    "workflow",
    "service",
    "beam",
    "bun"
  ],
  "license": "Apache-2.0"
}
